# Chép thành .env (đã bị .gitignore) rồi điền token. `task publish` nạp tệp này.
AK_TOKEN=
# Tuỳ chọn:
# AK_REPO_BASE=https://sa-hrm.vnrlocal.com:9091/api/v1/repositories/vnr-marketplace
# AK_ARTIFACT=marketplace.zip
# Registry dùng chứng chỉ CA nội bộ: cho Node tin kho chứng chỉ của Windows (Node ≥ 22.15)
# NODE_OPTIONS=--use-system-ca
